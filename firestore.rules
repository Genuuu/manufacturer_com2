rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Global Helpers & Authentication Primitives
    // =========================================================================

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'genukakisara@gmail.com' ||
        request.auth.token.email.lower() == '2020thilinasampath@gmail.com'
      );
    }

    function isAuthorizedUser() {
      return isBootstrappedAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/authorizedEmails/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/authorizedEmails/$(request.auth.token.email.lower())).data.isActive == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-|]+$');
    }

    function isValidEmailKey(emailKey) {
      return emailKey is string && emailKey.size() >= 3 && emailKey.size() <= 320;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalList(data, field, maxItems) {
      return !(field in data) || data[field] == null || (data[field] is list && data[field].size() <= maxItems);
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================

    function isValidManufacturer(data) {
      return data.keys().hasAll(['id', 'name', 'status'])
        && data.keys().hasOnly([
          'id',
          'name',
          'website',
          'contactPortal',
          'productsOfInterest',
          'notes',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && isValidString(data.name, 500)
        && data.status in ['Active', 'Removed', 'Archived']
        && isOptionalString(data, 'website', 1000)
        && isOptionalString(data, 'contactPortal', 1000)
        && isOptionalString(data, 'productsOfInterest', 5000)
        && isOptionalString(data, 'notes', 10000)
        && isOptionalString(data, 'createdAt', 64)
        && isOptionalString(data, 'updatedAt', 64);
    }

    function isValidCommunication(data) {
      return data.keys().hasAll(['id', 'date', 'manufacturerId', 'channel', 'subject'])
        && data.keys().hasOnly([
          'id',
          'date',
          'manufacturerId',
          'manufacturerName',
          'threadSelection',
          'threadId',
          'channel',
          'subject',
          'keyOutcome',
          'status',
          'nextAction',
          'followUpDate',
          'threadDoc',
          'fullEmailText',
          'documentsReceived',
          'attachments',
          'informationReceived',
          'chatTurns',
          'outboundSummary',
          'inboundResponse',
          'entryKey',
          'createdBy',
          'createdAt'
        ])
        && isValidId(data.id)
        && isValidString(data.date, 64)
        && isValidId(data.manufacturerId)
        && isValidString(data.channel, 200)
        && isValidString(data.subject, 2000)
        && isOptionalString(data, 'manufacturerName', 500)
        && isOptionalString(data, 'threadSelection', 128)
        && isOptionalString(data, 'threadId', 128)
        && isOptionalString(data, 'keyOutcome', 20000)
        && isOptionalString(data, 'status', 100)
        && isOptionalString(data, 'nextAction', 5000)
        && isOptionalString(data, 'followUpDate', 64)
        && isOptionalString(data, 'threadDoc', 1000)
        && isOptionalString(data, 'fullEmailText', 100000)
        && isOptionalList(data, 'documentsReceived', 100)
        && isOptionalList(data, 'attachments', 50)
        && isOptionalString(data, 'informationReceived', 50000)
        && isOptionalList(data, 'chatTurns', 200)
        && isOptionalString(data, 'outboundSummary', 20000)
        && isOptionalString(data, 'inboundResponse', 20000)
        && isOptionalString(data, 'entryKey', 128)
        && isOptionalString(data, 'createdBy', 200)
        && isOptionalString(data, 'createdAt', 64);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role'])
        && data.keys().hasOnly([
          'id',
          'name',
          'email',
          'role',
          'department',
          'avatar',
          'isActive',
          'lastLogin'
        ])
        && isValidId(data.id)
        && isValidString(data.name, 300)
        && isValidString(data.email, 320)
        && data.role in ['admin', 'moderator', 'viewer', 'manager', 'engineer', 'auditor']
        && isOptionalString(data, 'department', 300)
        && isOptionalString(data, 'avatar', 500)
        && (!('isActive' in data) || data.isActive is bool)
        && isOptionalString(data, 'lastLogin', 64);
    }

    function isValidAuthorizedEmail(data) {
      return data.keys().hasAll(['email', 'userId', 'role', 'isActive'])
        && data.keys().hasOnly(['email', 'userId', 'role', 'isActive'])
        && isValidString(data.email, 320)
        && isValidId(data.userId)
        && data.role in ['admin', 'moderator', 'viewer', 'manager', 'engineer', 'auditor']
        && data.isActive is bool;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'action', 'category'])
        && data.keys().hasOnly([
          'id',
          'timestamp',
          'userId',
          'userName',
          'action',
          'category',
          'details',
          'targetId'
        ])
        && isValidId(data.id)
        && isValidString(data.timestamp, 64)
        && isValidString(data.action, 200)
        && data.category in ['MANUFACTURER', 'COMMUNICATION', 'PERMISSION', 'DATA']
        && isOptionalString(data, 'userId', 128)
        && isOptionalString(data, 'userName', 300)
        && isOptionalString(data, 'details', 5000)
        && isOptionalString(data, 'targetId', 128);
    }

    function isValidSetting(settingId, data) {
      return isValidId(settingId)
        && (
          (settingId == 'googleSheetBackup'
            && data.keys().hasOnly([
              'spreadsheetId',
              'spreadsheetUrl',
              'spreadsheetTitle',
              'lastSyncedAt',
              'lastSyncedManufacturerCount',
              'lastSyncedCommCount',
              'lastSyncedHash'
            ])
            && isOptionalString(data, 'spreadsheetId', 256)
            && isOptionalString(data, 'spreadsheetUrl', 1000)
            && isOptionalString(data, 'spreadsheetTitle', 500)
            && isOptionalString(data, 'lastSyncedAt', 64)
            && (!('lastSyncedManufacturerCount' in data) || data.lastSyncedManufacturerCount is number)
            && (!('lastSyncedCommCount' in data) || data.lastSyncedCommCount is number)
            && isOptionalString(data, 'lastSyncedHash', 128)
          )
          ||
          (settingId == 'permissions'
            && data.keys().hasOnly(['admin', 'moderator', 'viewer', 'manager', 'engineer', 'auditor'])
          )
        );
    }

    function isValidEmailTemplate(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'subject', 'body'])
        && data.keys().hasOnly([
          'id',
          'title',
          'category',
          'subject',
          'body',
          'description',
          'updatedAt'
        ])
        && isValidId(data.id)
        && isValidString(data.title, 300)
        && isValidString(data.category, 100)
        && isValidString(data.subject, 1000)
        && isValidString(data.body, 50000)
        && isOptionalString(data, 'description', 1000)
        && isOptionalString(data, 'updatedAt', 64);
    }

    // =========================================================================
    // Collection Match Blocks (Restricted to Authorized Users Only)
    // =========================================================================

    match /manufacturers/{manufacturerId} {
      allow get: if isAuthorizedUser() && isValidId(manufacturerId);
      allow list: if isSignedIn();
      allow create, update: if isAuthorizedUser() && isValidId(manufacturerId) && isValidManufacturer(incoming());
      allow delete: if isAuthorizedUser() && isValidId(manufacturerId);
    }

    match /communications/{communicationId} {
      allow get: if isAuthorizedUser() && isValidId(communicationId);
      allow list: if isSignedIn();
      allow create, update: if isAuthorizedUser() && isValidId(communicationId) && isValidCommunication(incoming());
      allow delete: if isAuthorizedUser() && isValidId(communicationId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create, update: if isAuthorizedUser() && isValidId(userId) && isValidUser(incoming());
      allow delete: if isAuthorizedUser() && isValidId(userId);
    }

    match /authorizedEmails/{emailId} {
      allow get: if isSignedIn() && isValidEmailKey(emailId);
      allow list: if isSignedIn();
      allow create, update: if isAuthorizedUser() && isValidEmailKey(emailId) && isValidAuthorizedEmail(incoming());
      allow delete: if isAuthorizedUser() && isValidEmailKey(emailId);
    }

    match /auditLogs/{logId} {
      allow get: if isAuthorizedUser() && isValidId(logId);
      allow list: if isSignedIn();
      allow create, update: if isAuthorizedUser() && isValidId(logId) && isValidAuditLog(incoming());
      allow delete: if isAuthorizedUser() && isValidId(logId);
    }

    match /settings/{settingId} {
      allow get: if isAuthorizedUser() && isValidId(settingId);
      allow list: if isSignedIn();
      allow create, update: if isAuthorizedUser() && isValidSetting(settingId, incoming());
      allow delete: if isAuthorizedUser() && isValidId(settingId);
    }

    match /emailTemplates/{templateId} {
      allow get: if (
        isBootstrappedAdmin() || (
          isAuthorizedUser()
          && get(/databases/$(database)/documents/authorizedEmails/$(request.auth.token.email.lower())).data.role in ['admin', 'moderator', 'manager', 'engineer']
        )
      ) && isValidId(templateId);
      allow list: if isBootstrappedAdmin() || (
        isAuthorizedUser()
        && get(/databases/$(database)/documents/authorizedEmails/$(request.auth.token.email.lower())).data.role in ['admin', 'moderator', 'manager', 'engineer']
      );
      allow create, update: if (
        isBootstrappedAdmin() || (
          isAuthorizedUser()
          && get(/databases/$(database)/documents/authorizedEmails/$(request.auth.token.email.lower())).data.role == 'admin'
        )
      ) && isValidId(templateId) && isValidEmailTemplate(incoming());
      allow delete: if (
        isBootstrappedAdmin() || (
          isAuthorizedUser()
          && get(/databases/$(database)/documents/authorizedEmails/$(request.auth.token.email.lower())).data.role == 'admin'
        )
      ) && isValidId(templateId);
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
