rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /manufacturers/{manufacturerId} {
      allow read, write: if true;
    }
    match /communications/{communicationId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
